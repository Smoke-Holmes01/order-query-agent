# Read only by init/seed and the one-shot Compose bootstrap; never by app.
DB_ADMIN_HOST=127.0.0.1
DB_ADMIN_PORT=3307
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=replace_with_a_different_random_local_password
DB_ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost,db
# MySQL root is reachable only through loopback-published port / isolated network.
MYSQL_ROOT_HOST=%
